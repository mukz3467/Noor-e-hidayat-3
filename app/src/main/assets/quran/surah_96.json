{"code":200,"status":"OK","data":[{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"عَبْدًا إِذَا صَلَّىٰٓ","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"فَلْيَدْعُ نَادِيَهُۥ","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"سَنَدْعُ ٱلزَّبَانِيَةَ","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"جس نے انسان کو خون کی پھٹکی سے بنایا","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"پڑھو اور تمہارا پروردگار بڑا کریم ہے","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"جس نے قلم کے ذریعے سے علم سکھایا","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"مگر انسان سرکش ہو جاتا ہے","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"جب کہ اپنے تیئں غنی دیکھتا ہے","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"بھلا دیکھو تو اگر یہ راہِ راست پر ہو","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"یعنی اس جھوٹے خطاکار کی پیشانی کے بال","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"تو وہ اپنے یاروں کی مجلس کو بلالے","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"Recite in the name of your Lord who created -","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"Created man from a clinging substance.","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"Recite, and your Lord is the most Generous -","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"Who taught by the pen -","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"Taught man that which he knew not.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"No! [But] indeed, man transgresses","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"Because he sees himself self-sufficient.","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"Indeed, to your Lord is the return.","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"Have you seen the one who forbids","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"A servant when he prays?","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"Have you seen if he is upon guidance","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"Or enjoins righteousness?","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"Have you seen if he denies and turns away -","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"Does he not know that Allah sees?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"No! If he does not desist, We will surely drag him by the forelock -","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"A lying, sinning forelock.","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"Then let him call his associates;","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"We will call the angels of Hell.","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"No! Do not obey him. But prostrate and draw near [to Allah].","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"पढ़ो, अपने रब के नाम के साथ जिसने पैदा किया,","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"पैदा किया मनुष्य को जमे हुए ख़ून के एक लोथड़े से","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"पढ़ो, हाल यह है कि तुम्हारा रब बड़ा ही उदार है,","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"जिसने क़लम के द्वारा शिक्षा दी,","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"मनुष्य को वह ज्ञान प्रदान किया जिस वह न जानता था","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"कदापि नहीं, मनुष्य सरकशी करता है,","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"इसलिए कि वह अपने आपको आत्मनिर्भर देखता है","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"निश्चय ही तुम्हारे रब ही की ओर पलटना है","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"क्या तुमने देखा उस व्यक्ति को","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"जो एक बन्दे को रोकता है, जब वह नमाज़ अदा करता है? -","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"तुम्हारा क्या विचार है? यदि वह सीधे मार्ग पर हो,","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"या परहेज़गारी का हुक्म दे (उसके अच्छा होने में क्या संदेह है)","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"तुम्हारा क्या विचार है? यदि उस (रोकनेवाले) ने झुठलाया और मुँह मोड़ा (तो उसके बुरा होने में क्या संदेह है) -","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"क्या उसने नहीं जाना कि अल्लाह देख रहा है?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"कदापि नहीं, यदि वह बाज़ न आया तो हम चोटी पकड़कर घसीटेंगे,","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"झूठी, ख़ताकार चोटी","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"अब बुला ले वह अपनी मजलिस को!","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"हम भी बुलाए लेते है सिपाहियों को","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"कदापि नहीं, उसकी बात न मानो और सजदे करते और क़रीब होते रहो","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}