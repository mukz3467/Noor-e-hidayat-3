{"code":200,"status":"OK","data":[{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"وَمَا هُوَ بِٱلْهَزْلِ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"وَأَكِيدُ كَيْدًۭا","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"آسمان اور رات کے وقت آنے والے کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"اور تم کو کیا معلوم کہ رات کے وقت آنے والا کیا ہے","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"وہ تارا ہے چمکنے والا","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"کہ کوئی متنفس نہیں جس پر نگہبان مقرر نہیں","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"تو انسان کو دیکھنا چاہئے کہ وہ کاہے سے پیدا ہوا ہے","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"وہ اچھلتے ہوئے پانی سے پیدا ہوا ہے","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"جو پیٹھ اور سینے کے بیچ میں سے نکلتا ہے","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"بےشک خدا اس کے اعادے (یعنی پھر پیدا کرنے) پر قادر ہے","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"جس دن دلوں کے بھید جانچے جائیں گے","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"تو انسان کی کچھ پیش نہ چل سکے گی اور نہ کوئی اس کا مددگار ہو گا","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"آسمان کی قسم جو مینہ برساتا ہے","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"اور زمین کی قسم جو پھٹ جاتی ہے","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"کہ یہ کلام (حق کو باطل سے) جدا کرنے والا ہے","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"اور بیہودہ بات نہیں ہے","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"یہ لوگ تو اپنی تدبیروں میں لگ رہے ہیں","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"اور ہم اپنی تدبیر کر رہے ہیں","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"تو تم کافروں کو مہلت دو بس چند روز ہی مہلت دو","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"By the sky and the night comer -","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"And what can make you know what is the night comer?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"It is the piercing star -","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"There is no soul but that it has over it a protector.","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"So let man observe from what he was created.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"He was created from a fluid, ejected,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"Emerging from between the backbone and the ribs.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"Indeed, Allah, to return him [to life], is Able.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"The Day when secrets will be put on trial,","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"Then man will have no power or any helper.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"By the sky which returns [rain]","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"And [by] the earth which cracks open,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"Indeed, the Qur'an is a decisive statement,","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"And it is not amusement.","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"Indeed, they are planning a plan,","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"But I am planning a plan.","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"So allow time for the disbelievers. Leave them awhile.","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":86,"name":"سُورَةُ الطَّارِقِ","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"साक्षी है आकाश, और रात में प्रकट होनेवाला -","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"और तुम क्या जानो कि रात में प्रकट होनेवाला क्या है?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"दमकता हुआ तारा! -","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"कि हर एक व्यक्ति पर एक निगरानी करनेवाला नियुक्त है","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"अतः मनुष्य को चाहिए कि देखे कि वह किस चीज़ से पैदा किया गया है","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"एक उछलते पानी से पैदा किया गया है,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"जो पीठ और पसलियों के मध्य से निकलता है","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"निश्चय ही वह उसके लौटा देने की सामर्थ्य रखता है","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"जिस दिन छिपी चीज़ें परखी जाएँगी,","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"तो उस समय उसके पास न तो अपनी कोई शक्ति होगी और न कोई सहायक","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"साक्षी है आवर्तन (उलट-फेर) वाला आकाश,","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"और फट जानेवाली धरती","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"वह दो-टूक बात है,","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"वह कोई हँसी-मज़ाक नही है","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"वे एक चाल चल रहे है,","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"और मैं भी एक चाल चल रहा हूँ","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"अत मुहलत दे दो उन इनकार करनेवालों को; मुहलत दे दो उन्हें थोड़ी-सी","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}