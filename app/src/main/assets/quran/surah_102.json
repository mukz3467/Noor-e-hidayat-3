{"code":200,"status":"OK","data":[{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"لَتَرَوُنَّ ٱلْجَحِيمَ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"(لوگو) تم کو (مال کی) بہت سی طلب نے غافل کر دیا","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"یہاں تک کہ تم نے قبریں جا دیکھیں","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"دیکھو تمہیں عنقریب معلوم ہو جائے گا","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"پھر دیکھو تمہیں عنقریب معلوم ہو جائے گا","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"دیکھو اگر تم جانتے (یعنی) علم الیقین (رکھتے تو غفلت نہ کرتے)","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"تم ضرور دوزخ کو دیکھو گے","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"پھر اس کو (ایسا) دیکھو گے (کہ) عین الیقین (آ جائے گا)","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"پھر اس روز تم سے (شکر) نعمت کے بارے میں پرسش ہو گی","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"Competition in [worldly] increase diverts you","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"Until you visit the graveyards.","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"No! You are going to know.","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"Then no! You are going to know.","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"No! If you only knew with knowledge of certainty...","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"You will surely see the Hellfire.","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"Then you will surely see it with the eye of certainty.","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"Then you will surely be asked that Day about pleasure.","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":102,"name":"سُورَةُ التَّكَاثُرِ","englishName":"At-Takaathur","englishNameTranslation":"Competition","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6169,"text":"तुम्हें एक-दूसरे के मुक़ाबले में बहुतायत के प्रदर्शन और घमंड ने ग़फ़़लत में डाल रखा है,","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6170,"text":"यहाँ तक कि तुम क़ब्रिस्तानों में पहुँच गए","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6171,"text":"कुछ नहीं, तुम शीघ्र ही जान लोगे","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6172,"text":"फिर, कुछ नहीं, तुम्हें शीघ्र ही मालूम हो जाएगा -","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6173,"text":"कुछ नहीं, अगर तुम विश्वसनीय ज्ञान के रूप में जान लो! (तो तुम धन-दौलत के पुजारी न बनो) -","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6174,"text":"अवश्य ही तुम भड़कती आग से दो-चार होगे","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6175,"text":"फिर सुनो, उसे अवश्य देखोगे इस दशा में कि वह यथावत विश्वास होगा","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false},{"number":6176,"text":"फिर निश्चय ही उस दिन तुमसे नेमतों के बारे में पूछा जाएगा","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":544,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}