{"code":200,"status":"OK","data":[{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًۭا","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"جب خدا کی مدد آ پہنچی اور فتح (حاصل ہو گئی)","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"اور تم نے دیکھ لیا کہ لوگ غول کے غول خدا کے دین میں داخل ہو رہے ہیں","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"تو اپنے پروردگار کی تعریف کے ساتھ تسبیح کرو اور اس سے مغفرت مانگو، بے شک وہ معاف کرنے والا ہے","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"When the victory of Allah has come and the conquest,","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"And you see the people entering into the religion of Allah in multitudes,","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":110,"name":"سُورَةُ النَّصۡرِ","englishName":"An-Nasr","englishNameTranslation":"Divine Support","revelationType":"Medinan","numberOfAyahs":3,"ayahs":[{"number":6214,"text":"जब अल्लाह की सहायता आ जाए और विजय प्राप्त हो,","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6215,"text":"और तुम लोगों को देखो कि वे अल्लाह के दीन (धर्म) में गिरोह के गिरोह प्रवेश कर रहे है,","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false},{"number":6216,"text":"तो अपने रब की प्रशंसा करो और उससे क्षमा चाहो। निस्संदेह वह बड़ा तौबा क़बूल करनेवाला है","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":552,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}