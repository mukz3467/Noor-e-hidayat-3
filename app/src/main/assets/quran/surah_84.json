{"code":200,"status":"OK","data":[{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"وَيَصْلَىٰ سَعِيرًا","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"وَٱلَّيْلِ وَمَا وَسَقَ","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"جب آسمان پھٹ جائے گا","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"اور اپنے پروردگار کا فرمان بجا لائے گا اور اسے واجب بھی یہ ہی ہے","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"اور جب زمین ہموار کر دی جائے گی","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"جو کچھ اس میں ہے اسے نکال کر باہر ڈال دے گی اور (بالکل) خالی ہو جائے گی","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"اور اپنے پروردگار کے ارشاد کی تعمیل کرے گی اور اس کو لازم بھی یہی ہے (تو قیامت قائم ہو جائے گی)","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"اے انسان! تو اپنے پروردگار کی طرف (پہنچنے میں) خوب کوشِش کرتا ہے سو اس سے جا ملے گا","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"تو جس کا نامہٴ (اعمال) اس کے داہنے ہاتھ میں دیا جائے گا","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"اس سے حساب آسان لیا جائے گا","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"اور وہ اپنے گھر والوں میں خوش خوش آئے گا","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"اور جس کا نامہٴ (اعمال) اس کی پیٹھ کے پیچھے سے دیا جائے گا","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"وہ موت کو پکارے گا","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"اور وہ دوزخ میں داخل ہو گا","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"یہ اپنے اہل (و عیال) میں مست رہتا تھا","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"اور خیال کرتا تھا کہ (خدا کی طرف) پھر کر نہ جائے گا","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"ہاں ہاں۔ اس کا پروردگار اس کو دیکھ رہا تھا","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"ہمیں شام کی سرخی کی قسم","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"اور رات کی اور جن چیزوں کو وہ اکٹھا کر لیتی ہے ان کی","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"اور چاند کی جب کامل ہو جائے","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"کہ تم درجہ بدرجہ (رتبہٴ اعلیٰ پر) چڑھو گے","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"تو ان لوگوں کو کیا ہوا ہے کہ ایمان نہیں لاتے","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"اور جب ان کے سامنے قرآن پڑھا جاتا ہے تو سجدہ نہیں کرتے","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"بلکہ کافر جھٹلاتے ہیں","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"اور خدا ان باتوں کو جو یہ اپنے دلوں میں چھپاتے ہیں خوب جانتا ہے","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"تو ان کو دکھ دینے والے عذاب کی خبر سنا دو","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"ہاں جو لوگ ایمان لائے اور نیک عمل کرتے رہے ان کے لیے بےانتہا اجر ہے","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"When the sky has split [open]","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"And has responded to its Lord and was obligated [to do so]","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"And when the earth has been extended","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"And has cast out that within it and relinquished [it]","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"And has responded to its Lord and was obligated [to do so] -","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"Then as for he who is given his record in his right hand,","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"He will be judged with an easy account","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"And return to his people in happiness.","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"But as for he who is given his record behind his back,","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"He will cry out for destruction","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"And [enter to] burn in a Blaze.","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"Indeed, he had [once] been among his people in happiness;","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"Indeed, he had thought he would never return [to Allah].","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"But yes! Indeed, his Lord was ever of him, Seeing.","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"So I swear by the twilight glow","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"And [by] the night and what it envelops","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"And [by] the moon when it becomes full","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"[That] you will surely experience state after state.","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"So what is [the matter] with them [that] they do not believe,","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"And when the Qur'an is recited to them, they do not prostrate [to Allah]?","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"But those who have disbelieved deny,","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"And Allah is most knowing of what they keep within themselves.","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"So give them tidings of a painful punishment,","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted.","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"जबकि आकाश फट जाएगा,","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"और वह अपने रब की सुनेगा, और उसे यही चाहिए भी","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"जब धरती फैला दी जाएगी","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"और जो कुछ उसके भीतर है उसे बाहर डालकर खाली हो जाएगी","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"और वह अपने रब की सुनेगी, और उसे यही चाहिए भी","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"ऐ मनुष्य! तू मशक़्क़त करता हुआ अपने रब ही की ओर खिंचा चला जा रहा है और अन्ततः उससे मिलने वाला है","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"फिर जिस किसी को उसका कर्म-पत्र उसके दाहिने हाथ में दिया गया,","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"तो उससे आसान, सरसरी हिसाब लिया जाएगा","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"और वह अपने लोगों की ओर ख़ुश-ख़ुश पलटेगा","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"और रह वह व्यक्ति जिसका कर्म-पत्र (उसके बाएँ हाथ में) उसकी पीठ के पीछे से दिया गया,","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"तो वह विनाश (मृत्यु) को पुकारेगा,","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"और दहकती आग में जा पड़ेगा","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"वह अपने लोगों में मग्न था,","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"उसने यह समझ रखा था कि उसे कभी पलटना नहीं है","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"क्यों नहीं, निश्चय ही उसका रब तो उसे देख रहा था!","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"अतः कुछ नहीं, मैं क़सम खाता हूँ सांध्य-लालिमा की,","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"और रात की और उसके समेट लेने की,","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"और चन्द्रमा की जबकि वह पूर्ण हो जाता है,","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"निश्चय ही तुम्हें मंजिल पर मंजिल चढ़ना है","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"फिर उन्हें क्या हो गया है कि ईमान नहीं लाते?","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"और जब उन्हें कुरआन पढ़कर सुनाया जाता है तो सजदे में नहीं गिर पड़ते?","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"नहीं, बल्कि इनकार करनेवाले तो झुठलाते है,","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"हालाँकि जो कुछ वे अपने अन्दर एकत्र कर रहे है, अल्लाह उसे भली-भाँति जानता है","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"अतः उन्हें दुखद यातना की मंगल सूचना दे दो","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"अलबत्ता जो लोग ईमान लाए और उन्होंने अच्छे कर्म किए उनके लिए कभी न समाप्त॥ होनेवाला प्रतिदान है","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","form