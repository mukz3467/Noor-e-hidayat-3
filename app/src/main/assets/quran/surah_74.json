ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"اور ناپاکی سے دور رہو","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"اور (اس نیت سے) احسان نہ کرو کہ اس سے زیادہ کے طالب ہو","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"اور اپنے پروردگار کے لئے صبر کرو","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"جب صور پھونکا جائے گا","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"وہ دن کا مشکل دن ہوگا","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"(یعنی) کافروں پر آسان نہ ہوگا","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"ہمیں اس شخص سے سمجھ لینے دو جس کو ہم نے اکیلا پیدا کیا","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"اور مال کثیر دیا","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"اور (ہر وقت اس کے پاس) حاضر رہنے والے بیٹے دیئے","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"اور ہر طرح کے سامان میں وسعت دی","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"ابھی خواہش رکھتا ہے کہ اور زیادہ دیں","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"ایسا ہرگز نہیں ہوگا۔ یہ ہماری آیتیں کا دشمن رہا ہے","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"ہم اسے صعود پر چڑھائیں گے","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"اس نے فکر کیا اور تجویز کی","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"یہ مارا جائے اس نے کیسی تجویز کی","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"پھر یہ مارا جائے اس نے کیسی تجویز کی","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"پھر تامل کیا","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"پھر تیوری چڑھائی اور منہ بگاڑ لیا","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"پھر پشت پھیر کر چلا اور (قبول حق سے) غرور کیا","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"پھر کہنے لگا کہ یہ تو جادو ہے جو (اگلوں سے) منتقل ہوتا آیا ہے","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"(پھر بولا) یہ (خدا کا کلام نہیں بلکہ) بشر کا کلام ہے","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"ہم عنقریب اس کو سقر میں داخل کریں گے","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"اور تم کیا سمجھے کہ سقر کیا ہے؟","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"(وہ آگ ہے کہ) نہ باقی رکھے گی اور نہ چھوڑے گی","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"اور بدن جھلس کر سیاہ کردے گی","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"اس پر اُنیس داروغہ ہیں","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"اور ہم نے دوزخ کے داروغہ فرشتے بنائے ہیں۔ اور ان کا شمار کافروں کی آزمائش کے لئے مقرر کیا ہے (اور) اس لئے کہ اہل کتاب یقین کریں اور مومنوں کا ایمان اور زیادہ ہو اور اہل کتاب اور مومن شک نہ لائیں۔ اور اس لئے کہ جن لوگوں کے دلوں میں (نفاق کا) مرض ہے اور (جو) کافر (ہیں) کہیں کہ اس مثال (کے بیان کرنے) سے خدا کا مقصد کیا ہے؟ اسی طرح خدا جس کو چاہتا ہے گمراہ کرتا ہے اور جس کو چاہتا ہے ہدایت کرتا ہے اور تمہارے پروردگار کے لشکروں کو اس کے سوا کوئی نہیں جانتا۔ اور یہ تو بنی آدم کے لئے نصیحت ہے","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"ہاں ہاں (ہمیں) چاند کی قسم","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"اور رات کی جب پیٹھ پھیرنے لگے","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"اور صبح کی جب روشن ہو","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"کہ وہ (آگ) ایک بہت بڑی (آفت) ہے","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"(اور) بنی آدم کے لئے مؤجب خوف","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"جو تم میں سے آگے بڑھنا چاہے یا پیچھے رہنا چاہے","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"ہر شخص اپنے اعمال کے بدلے گرو ہے","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"مگر داہنی طرف والے (نیک لوگ)","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"(کہ) وہ باغہائے بہشت میں (ہوں گے اور) پوچھتے ہوں گے","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"(یعنی آگ میں جلنے والے) گنہگاروں سے","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"کہ تم دوزخ میں کیوں پڑے؟","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"وہ جواب دیں گے کہ ہم نماز نہیں پڑھتے تھے","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"اور نہ فقیروں کو کھانا کھلاتے تھے","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"اور اہل باطل کے ساتھ مل کر (حق سے) انکار کرتے تھے","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"اور روز جزا کو جھٹلاتے تھے","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"یہاں تک کہ ہمیں موت آگئی","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"(تو اس حال میں) سفارش کرنے والوں کی سفارش ان کے حق میں کچھ فائدہ نہ دے گی","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"ان کو کیا ہوا ہے کہ نصیحت سے روگرداں ہو رہے ہیں","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"گویا گدھے ہیں کہ بدک جاتے ہیں","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"(یعنی) شیر سے ڈر کر بھاگ جاتے ہیں","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"اصل یہ ہے کہ ان میں سے ہر شخص یہ چاہتا ہے کہ اس کے پاس کھلی ہوئی کتاب آئے","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"ایسا ہرگز نہیں ہوگا۔ حقیقت یہ ہے کہ ان کو آخرت کا خوف ہی نہیں","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"کچھ شک نہیں کہ یہ نصیحت ہے","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"تو جو چاہے اسے یاد رکھے","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"اور یاد بھی تب ہی رکھیں گے جب خدا چاہے۔ وہی ڈرنے کے لائق اور بخشش کا مالک ہے","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"O you who covers himself [with a garment],","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"Arise and warn","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"And your Lord glorify","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5499,"text":"And your clothing purify","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"And uncleanliness avoid","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"And do not confer favor to acquire more","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"But for your Lord be patient.","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"And when the trumpet is blown,","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"That Day will be a difficult day","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"For the disbelievers - not easy.","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"Leave Me with the one I created alone","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"And to whom I granted extensive wealth","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"And children present [with him]","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"And spread [everything] before him, easing [his life].","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"Then he desires that I should add more.","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"No! Indeed, he has been toward Our verses obstinate.","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"I will cover him with arduous torment.","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"Indeed, he thought and deliberated.","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"So may he be destroyed [for] how he deliberated.","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"Then may he be destroyed [for] how he deliberated.","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"Then he considered [again];","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"Then he frowned and scowled;","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"Then he turned back and was arrogant","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"And said, \"This is not but magic imitated [from others].","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"This is not but the word of a human being.\"","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"I will drive him into Saqar.","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"And what can make you know what is Saqar?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"It lets nothing remain and leaves nothing [unburned],","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"Blackening the skins.","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"Over it are nineteen [angels].","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"And We have not made the keepers of the Fire except angels. And We have not made their number except as a trial for those who disbelieve - that those who were given the Scripture will be convinced and those who have believed will increase in faith and those who were given the Scripture and the believers will not doubt and that those in whose hearts is hypocrisy and the disbelievers will say, \"What does Allah intend by this as an example?\" Thus does Allah leave astray whom He wills and guides whom He wills. And none knows the soldiers of your Lord except Him. And mention of the Fire is not but a reminder to humanity.","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"No! By the moon","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"And [by] the night when it departs","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"And [by] the morning when it brightens,","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"Indeed, the Fire is of the greatest [afflictions]","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"As a warning to humanity -","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"To whoever wills among you to proceed or stay behind.","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"Every soul, for what it has earned, will be retained","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"Except the companions of the right,","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"[Who will be] in gardens, questioning each other","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"About the criminals,","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"[And asking them], \"What put you into Saqar?\"","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"They will say, \"We were not of those who prayed,","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"Nor did we used to feed the poor.","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"And we used to enter into vain discourse with those who engaged [in it],","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"And we used to deny the Day of Recompense","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"Until there came to us the certainty.\"","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"So there will not benefit them the intercession of [any] intercessors.","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"Then what is [the matter] with them that they are, from the reminder, turning away","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"As if they were alarmed donkeys","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"Fleeing from a lion?","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"Rather, every person among them desires that he would be given scriptures spread about.","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"No! But they do not fear the Hereafter.","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"No! Indeed, the Qur'an is a reminder","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"Then whoever wills will remember it.","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"And they will not remember except that Allah wills. He is worthy of fear and adequate for [granting] forgiveness.","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"ऐ ओढ़ने लपेटनेवाले!","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"उठो, और सावधान करने में लग जाओ","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"और अपने रब की बड़ाई ही करो","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5499,"text":"अपने दामन को पाक रखो","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"और गन्दगी से दूर ही रहो","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"अपनी कोशिशों को अधिक समझकर उसके क्रम को भंग न करो","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"और अपने रब के लिए धैर्य ही से काम लो","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"जब सूर में फूँक मारी जाएगी","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"तो जिस दिन ऐसा होगा, वह दिन बड़ा ही कठोर होगा,","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"इनकार करनेवालो पर आसान न होगा","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"छोड़ दो मुझे और उसको जिसे मैंने अकेला पैदा किया,","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"और उसे माल दिया दूर तक फैला हुआ,","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"और उसके पास उपस्थित रहनेवाले बेटे दिए,","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"और मैंने उसके लिए अच्छी तरह जीवन-मार्ग समतल किया","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"फिर वह लोभ रखता है कि मैं उसके लिए और अधिक दूँगा","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"कदापि नहीं, वह हमारी आयतों का दुश्मन है,","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"शीघ्र ही मैं उसे घेरकर कठिन चढ़ाई चढ़वाऊँगा","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"उसने सोचा और अटकल से एक बात बनाई","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"तो विनष्ट हो, कैसी बात बनाई!","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"फिर विनष्ट हो, कैसी बात बनाई!","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"फिर नज़र दौड़ाई,","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"फिर त्योरी चढ़ाई और मुँह बनाया,","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"फिर पीठ फेरी और घमंड किया","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"अन्ततः बोला, \"यह तो बस एक जादू है, जो पहले से चला आ रहा है","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"\"यह तो मात्र मनुष्य की वाणी है।\"","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"मैं शीघ्र ही उसे 'सक़र' (जहन्नम की आग) में झोंक दूँगा","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"और तुम्हें क्या पता की सक़र क्या है?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"वह न तरस खाएगी और न छोड़ेगी,","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"खाल को झुलसा देनेवाली है,","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"उसपर उन्नीस (कार्यकर्ता) नियुक्त है","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"और हमने उस आग पर नियुक्त रहनेवालों को फ़रिश्ते ही बनाया है, और हमने उनकी संख्या को इनकार करनेवालों के लिए मुसीबत और आज़माइश ही बनाकर रखा है। ताकि वे लोग जिन्हें किताब प्रदान की गई थी पूर्ण विश्वास प्राप्त करें, और वे लोग जो ईमान ले आए वे ईमान में और आगे बढ़ जाएँ। और जिन लोगों को किताब प्रदान की गई वे और ईमानवाले किसी संशय मे न पड़े, और ताकि जिनके दिलों मे रोग है वे और इनकार करनेवाले कहें, \"इस वर्णन से अल्लाह का क्या अभिप्राय है?\" इस प्रकार अल्लाह जिसे चाहता है पथभ्रष्ट कर देता है और जिसे चाहता हैं संमार्ग प्रदान करता है। और तुम्हारे रब की सेनाओं को स्वयं उसके सिवा कोई नहीं जानता, और यह तो मनुष्य के लिए मात्र एक शिक्षा-सामग्री है","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"कुछ नहीं, साक्षी है चाँद","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"और साक्षी है रात जबकि वह पीठ फेर चुकी,","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"और प्रातःकाल जबकि वह पूर्णरूपेण प्रकाशित हो जाए।","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"निश्चय ही वह भारी (भयंकर) चीज़ों में से एक है,","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"मनुष्यों के लिए सावधानकर्ता के रूप में,","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"तुममें से उस व्यक्ति के लिए जो आगे बढ़ना या पीछे हटना चाहे","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"प्रत्येक व्यक्ति जो कुछ उसने कमाया उसके बदले रेहन (गिरवी) है,","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"सिवाय दाएँवालों के","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"वे बाग़ों में होंगे, पूछ-ताछ कर रहे होंगे","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"अपराधियों के विषय में","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"\"तुम्हे क्या चीज़ सकंर (जहन्नम) में ले आई?\"","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"वे कहेंगे, \"हम नमाज़ अदा करनेवालों में से न थे।","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"और न हम मुहताज को खाना खिलाते थे","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"\"और व्यर्थ बात और कठ-हुज्जती में पड़े रहनेवालों के साथ हम भी उसी में लगे रहते थे।","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"और हम बदला दिए जाने के दिन को झुठलाते थे,","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"\"यहाँ तक कि विश्वसनीय चीज़ (प्रलय-दिवस) में हमें आ लिया।\"","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"अतः सिफ़ारिश करनेवालों को कोई सिफ़ारिश उनको कुछ लाभ न पहुँचा सकेगी","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"आख़िर उन्हें क्या हुआ है कि वे नसीहत से कतराते है,","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"मानो वे बिदके हुए जंगली गधे है","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"जो शेर से (डरकर) भागे है?","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"नहीं, बल्कि उनमें से प्रत्येक व्यक्ति चाहता है कि उसे खुली किताबें दी जाएँ","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"कदापि नहीं, बल्कि ले आख़िरत से डरते नहीं","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"कुछ नहीं, वह तो एक अनुस्मति है","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"अब जो कोई चाहे इससे नसीहत हासिल करे,","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"और वे नसीहत हासिल नहीं करेंगे। यह और बात है कि अल्लाह ही ऐसा चाहे। वही इस योग्य है कि उसका डर रखा जाए और इस योग्य भी कि क्षमा करे","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}