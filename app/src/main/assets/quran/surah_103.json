{"code":200,"status":"OK","data":[{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6177,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَصْرِ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6178,"text":"إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6179,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6177,"text":"عصر کی قسم","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6178,"text":"کہ انسان نقصان میں ہے","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6179,"text":"مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6177,"text":"By time,","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6178,"text":"Indeed, mankind is in loss,","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6179,"text":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":103,"name":"سُورَةُ العَصۡرِ","englishName":"Al-Asr","englishNameTranslation":"The Declining Day, Epoch","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6177,"text":"गवाह है गुज़रता समय,","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6178,"text":"कि वास्तव में मनुष्य घाटे में है,","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false},{"number":6179,"text":"सिवाय उन लोगों के जो ईमान लाए और अच्छे कर्म किए और एक-दूसरे को हक़ की ताकीद की, और एक-दूसरे को धैर्य की ताकीद की","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":545,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}