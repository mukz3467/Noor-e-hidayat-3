{"code":200,"status":"OK","data":[{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"ٱللَّهُ ٱلصَّمَدُ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"معبود برحق جو بےنیاز ہے","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"نہ کسی کا باپ ہے اور نہ کسی کا بیٹا","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"اور کوئی اس کا ہمسر نہیں","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"Say, \"He is Allah, [who is] One,","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"Allah, the Eternal Refuge.","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"He neither begets nor is born,","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"Nor is there to Him any equivalent.\"","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"Al-Ikhlaas","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"कहो, \"वह अल्लाह यकता है,","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"अल्लाह निरपेक्ष (और सर्वाधार) है,","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"न वह जनिता है और न जन्य,","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"और न कोई उसका समकक्ष है।\"","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}