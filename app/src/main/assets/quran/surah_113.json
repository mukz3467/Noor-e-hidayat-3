{"code":200,"status":"OK","data":[{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"مِن شَرِّ مَا خَلَقَ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"کہو کہ میں صبح کے پروردگار کی پناہ مانگتا ہوں","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"ہر چیز کی بدی سے جو اس نے پیدا کی","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"اور شب تاریکی کی برائی سے جب اس کااندھیرا چھا جائے","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"اور گنڈوں پر (پڑھ پڑھ کر) پھونکنے والیوں کی برائی سے","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"اور حسد کرنے والے کی برائی سے جب حسد کرنے لگے","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"Say, \"I seek refuge in the Lord of daybreak","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"From the evil of that which He created","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"And from the evil of darkness when it settles","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"And from the evil of the blowers in knots","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"And from the evil of an envier when he envies.\"","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":113,"name":"سُورَةُ الفَلَقِ","englishName":"Al-Falaq","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6226,"text":"कहो, \"मैं शरण लेता हूँ, प्रकट करनेवाले रब की,","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6227,"text":"जो कुछ भी उसने पैदा किया उसकी बुराई से,","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6228,"text":"और अँधेरे की बुराई से जबकि वह घुस आए,","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6229,"text":"और गाँठो में फूँक मारने-वालों की बुराई से,","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false},{"number":6230,"text":"और ईर्ष्यालु की बुराई से, जब वह ईर्ष्या करे।\"","numberInSurah":5,"juz":30,"manzil":7,"page":604,"ruku":555,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}