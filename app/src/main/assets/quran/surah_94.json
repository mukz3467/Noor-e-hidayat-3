{"code":200,"status":"OK","data":[{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"وَوَضَعْنَا عَنكَ وِزْرَكَ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"وَرَفَعْنَا لَكَ ذِكْرَكَ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"فَإِذَا فَرَغْتَ فَٱنصَبْ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"اور تم پر سے بوجھ بھی اتار دیا","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"جس نے تمہاری پیٹھ توڑ رکھی تھی","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"اور تمہارا ذکر بلند کیا","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"ہاں ہاں مشکل کے ساتھ آسانی بھی ہے","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"(اور) بے شک مشکل کے ساتھ آسانی ہے","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"تو جب فارغ ہوا کرو تو (عبادت میں) محنت کیا کرو","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"اور اپنے پروردگار کی طرف متوجہ ہو جایا کرو","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"Did We not expand for you, [O Muhammad], your breast?","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"And We removed from you your burden","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"Which had weighed upon your back","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"And raised high for you your repute.","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"For indeed, with hardship [will be] ease.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"Indeed, with hardship [will be] ease.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"So when you have finished [your duties], then stand up [for worship].","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"And to your Lord direct [your] longing.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":94,"name":"سُورَةُ الشَّرۡحِ","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"क्या ऐसा नहीं कि हमने तुम्हारा सीना तुम्हारे लिए खोल दिया?","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"और तुमपर से तुम्हारा बोझ उतार दिया,","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"जो तुम्हारी कमर तोड़े डाल रहा था?","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6094,"text":"और तुम्हारे लिए तुम्हारे ज़िक्र को ऊँचा कर दिया?","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6095,"text":"अतः निस्संदेह कठिनाई के साथ आसानी भी है","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6096,"text":"निस्संदेह कठिनाई के साथ आसानी भी है","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"अतः जब निवृत हो तो परिश्रम में लग जाओ,","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"और अपने रब से लौ लगाओ","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}