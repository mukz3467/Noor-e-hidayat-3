{"code":200,"status":"OK","data":[{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَّتْ يَدَآ أَبِى لَهَبٍۢ وَتَبَّ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"فِى جِيدِهَا حَبْلٌۭ مِّن مَّسَدٍۭ","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"ابولہب کے ہاتھ ٹوٹیں اور وہ ہلاک ہو","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"اس کے گلے میں مونج کی رسّی ہو گی","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"May the hands of Abu Lahab be ruined, and ruined is he.","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"His wealth will not avail him or that which he gained.","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"He will [enter to] burn in a Fire of [blazing] flame","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"And his wife [as well] - the carrier of firewood.","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"Around her neck is a rope of [twisted] fiber.","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":111,"name":"سُورَةُ المَسَدِ","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"टूट गए अबू लहब के दोनों हाथ और वह स्वयं भी विनष्ट हो गया!","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"न उसका माल उसके काम आया और न वह कुछ जो उसने कमाया","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"वह शीघ्र ही प्रज्वलित भड़कती आग में पड़ेगा,","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"और उसकी स्त्री भी ईधन लादनेवाली,","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"उसकी गरदन में खजूर के रेसों की बटी हुई रस्सी पड़ी है","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}