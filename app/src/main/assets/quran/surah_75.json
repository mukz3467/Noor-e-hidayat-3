َّىٰ","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"ہم کو روز قیامت کی قسم","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"اور نفس لوامہ کی (کہ سب لوگ اٹھا کر) کھڑے کئے جائیں گے","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"کیا انسان یہ خیال کرتا ہے کہ ہم اس کی (بکھری ہوئی) ہڈیاں اکٹھی نہیں کریں گے؟","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"ضرور کریں گے (اور) ہم اس بات پر قادر ہیں کہ اس کی پور پور درست کردیں","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"مگر انسان چاہتا ہے کہ آگے کو خود سری کرتا جائے","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"پوچھتا ہے کہ قیامت کا دن کب ہوگا؟","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"جب آنکھیں چندھیا جائیں","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"اور چاند گہنا جائے","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"اور سورج اور چاند جمع کردیئے جائیں","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"اس دن انسان کہے گا کہ (اب) کہاں بھاگ جاؤں؟","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"بےشک کہیں پناہ نہیں","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"اس روز پروردگار ہی کے پاس ٹھکانا ہے","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"اس دن انسان کو جو (عمل) اس نے آگے بھیجے اور پیچھے چھوڑے ہوں گے سب بتا دیئے جائیں گے","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"بلکہ انسان آپ اپنا گواہ ہے","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"اگرچہ عذر ومعذرت کرتا رہے","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"اور (اے محمدﷺ) وحی کے پڑھنے کے لئے اپنی زبان نہ چلایا کرو کہ اس کو جلد یاد کرلو","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"اس کا جمع کرنا اور پڑھانا ہمارے ذمے ہے","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"جب ہم وحی پڑھا کریں تو تم (اس کو سنا کرو اور) پھر اسی طرح پڑھا کرو","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"پھر اس (کے معانی) کا بیان بھی ہمارے ذمے ہے","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"مگر (لوگو) تم دنیا کو دوست رکھتے ہو","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"اور آخرت کو ترک کئے دیتے ہو","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"اس روز بہت سے منہ رونق دار ہوں گے","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"اور) اپنے پروردگار کے محو دیدار ہوں گے","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"اور بہت سے منہ اس دن اداس ہوں گے","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"خیال کریں گے کہ ان پر مصیبت واقع ہونے کو ہے","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"دیکھو جب جان گلے تک پہنچ جائے","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"اور لوگ کہنے لگیں (اس وقت) کون جھاڑ پھونک کرنے والا ہے","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"اور اس (جان بلب) نے سمجھا کہ اب سب سے جدائی ہے","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"اور پنڈلی سے پنڈلی لپٹ جائے","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"اس دن تجھ کو اپنے پروردگار کی طرف چلنا ہے","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"تو اس (ناعاقبت) اندیش نے نہ تو (کلام خدا) کی تصدیق کی نہ نماز پڑھی","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"بلکہ جھٹلایا اور منہ پھیر لیا","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"پھر اپنے گھر والوں کے پاس اکڑتا ہوا چل دیا","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"افسوس ہے تجھ پر پھر افسوس ہے","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"پھر افسوس ہے تجھ پر پھر افسوس ہے","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"کیا انسان خیال کرتا ہے کہ یوں ہی چھوڑ دیا جائے گا؟","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"کیا وہ منی کا جو رحم میں ڈالی جاتی ہے ایک قطرہ نہ تھا؟","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"پھر لوتھڑا ہوا پھر (خدا نے) اس کو بنایا پھر (اس کے اعضا کو) درست کیا","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"پھر اس کی دو قسمیں بنائیں (ایک) مرد اور (ایک) عورت","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"کیا اس خالق کو اس بات پر قدرت نہیں کہ مردوں کو جلا اُٹھائے؟","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"I swear by the Day of Resurrection","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"And I swear by the reproaching soul [to the certainty of resurrection].","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"Does man think that We will not assemble his bones?","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"Yes. [We are] Able [even] to proportion his fingertips.","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"But man desires to continue in sin.","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"He asks, \"When is the Day of Resurrection?\"","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"So when vision is dazzled","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"And the moon darkens","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"And the sun and the moon are joined,","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"Man will say on that Day, \"Where is the [place of] escape?\"","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"No! There is no refuge.","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"To your Lord, that Day, is the [place of] permanence.","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"Man will be informed that Day of what he sent ahead and kept back.","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"Rather, man, against himself, will be a witness,","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"Even if he presents his excuses.","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an.","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"Indeed, upon Us is its collection [in your heart] and [to make possible] its recitation.","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"So when We have recited it [through Gabriel], then follow its recitation.","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"Then upon Us is its clarification [to you].","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"No! But you love the immediate","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"And leave the Hereafter.","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"[Some] faces, that Day, will be radiant,","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"Looking at their Lord.","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"And [some] faces, that Day, will be contorted,","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"Expecting that there will be done to them [something] backbreaking.","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"No! When the soul has reached the collar bones","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"And it is said, \"Who will cure [him]?\"","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"And the dying one is certain that it is the [time of] separation","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"And the leg is wound about the leg,","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"To your Lord, that Day, will be the procession.","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"And the disbeliever had not believed, nor had he prayed.","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"But [instead], he denied and turned away.","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"And then he went to his people, swaggering [in pride].","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"Woe to you, and woe!","numberInSurah":34,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5586,"text":"Then woe to you, and woe!","numberInSurah":35,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5587,"text":"Does man think that he will be left neglected?","numberInSurah":36,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5588,"text":"Had he not been a sperm from semen emitted?","numberInSurah":37,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5589,"text":"Then he was a clinging clot, and [Allah] created [his form] and proportioned [him]","numberInSurah":38,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5590,"text":"And made of him two mates, the male and the female.","numberInSurah":39,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5591,"text":"Is not that [Creator] Able to give life to the dead?","numberInSurah":40,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama","englishNameTranslation":"The Resurrection","revelationType":"Meccan","numberOfAyahs":40,"ayahs":[{"number":5552,"text":"नहीं, मैं क़सम खाता हूँ क़ियामत के दिन की,","numberInSurah":1,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5553,"text":"और नहीं! मैं कसम खाता हूँ मलामत करनेवाली आत्मा की","numberInSurah":2,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5554,"text":"क्या मनुष्य यह समझता है कि हम कदापि उसकी हड्डियों को एकत्र न करेंगे?","numberInSurah":3,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5555,"text":"क्यों नहीं, हम उसकी पोरों को ठीक-ठाक करने की सामर्थ्य रखते है","numberInSurah":4,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5556,"text":"बल्कि मनुष्य चाहता है कि अपने आगे ढिठाई करता रहे","numberInSurah":5,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5557,"text":"पूछता है, \"आख़िर क़ियामत का दिन कब आएगा?\"","numberInSurah":6,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5558,"text":"तो जब निगाह चौंधिया जाएगी,","numberInSurah":7,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5559,"text":"और चन्द्रमा को ग्रहण लग जाएगा,","numberInSurah":8,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5560,"text":"और सूर्य और चन्द्रमा इकट्ठे कर दिए जाएँगे,","numberInSurah":9,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5561,"text":"उस दिन मनुष्य कहेगा, \"कहाँ जाऊँ भागकर?\"","numberInSurah":10,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5562,"text":"कुछ नहीं, कोई शरण-स्थल नहीं!","numberInSurah":11,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5563,"text":"उस दिन तुम्हारे रब ही ओर जाकर ठहरना है","numberInSurah":12,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5564,"text":"उस दिन मनुष्य को बता दिया जाएगा जो कुछ उसने आगे बढाया और पीछे टाला","numberInSurah":13,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5565,"text":"नहीं, बल्कि मनुष्य स्वयं अपने हाल पर निगाह रखता है,","numberInSurah":14,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5566,"text":"यद्यपि उसने अपने कितने ही बहाने पेश किए हो","numberInSurah":15,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5567,"text":"तू उसे शीघ्र पाने के लिए उसके प्रति अपनी ज़बान को न चला","numberInSurah":16,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5568,"text":"हमारे ज़िम्मे है उसे एकत्र करना और उसका पढ़ना,","numberInSurah":17,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5569,"text":"अतः जब हम उसे पढ़े तो उसके पठन का अनुसरण कर,","numberInSurah":18,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5570,"text":"फिर हमारे ज़िम्मे है उसका स्पष्टीकरण करना","numberInSurah":19,"juz":29,"manzil":7,"page":577,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5571,"text":"कुछ नहीं, बल्कि तुम लोग शीघ्र मिलनेवाली चीज़ (दुनिया) से प्रेम रखते हो,","numberInSurah":20,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5572,"text":"और आख़िरत को छोड़ रहे हो","numberInSurah":21,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5573,"text":"किनते ही चहरे उस दिन तरो ताज़ा और प्रफुल्लित होंगे,","numberInSurah":22,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5574,"text":"अपने रब की ओर देख रहे होंगे।","numberInSurah":23,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5575,"text":"और कितने ही चेहरे उस दिन उदास और बिगड़े हुए होंगे,","numberInSurah":24,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5576,"text":"समझ रहे होंगे कि उनके साथ कमर तोड़ देनेवाला मामला किया जाएगा","numberInSurah":25,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5577,"text":"कुछ नहीं, जब प्राण कंठ को आ लगेंगे,","numberInSurah":26,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5578,"text":"और कहा जाएगा, \"कौन है झाड़-फूँक करनेवाला?\"","numberInSurah":27,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5579,"text":"और वह समझ लेगा कि वह जुदाई (का समय) है","numberInSurah":28,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5580,"text":"और पिंडली से पिंडली लिपट जाएगी,","numberInSurah":29,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5581,"text":"तुम्हारे रब की ओर उस दिन प्रस्थान होगा","numberInSurah":30,"juz":29,"manzil":7,"page":578,"ruku":512,"hizbQuarter":231,"sajda":false},{"number":5582,"text":"किन्तु उसने न तो सत्य माना और न नमाज़ अदा की,","numberInSurah":31,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5583,"text":"लेकिन झुठलाया और मुँह मोड़ा,","numberInSurah":32,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5584,"text":"फिर अकड़ता हुआ अपने लोगों की ओर चल दिया","numberInSurah":33,"juz":29,"manzil":7,"page":578,"ruku":513,"hizbQuarter":231,"sajda":false},{"number":5585,"text":"अफ़सोस है तुझपर और अफ़सोस है!","numberInSurah":34,"