{"code":200,"status":"OK","data":[{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"كِرَامًۭا كَٰتِبِينَ","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"يَعْلَمُونَ مَا تَفْعَلُونَ","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"جب آسمان پھٹ جائے گا","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"اور جب تارے جھڑ پڑیں گے","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"اور جب قبریں اکھیڑ دی جائیں گی","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"اور جس صورت میں چاہا تجھے جوڑ دیا","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"حالانکہ تم پر نگہبان مقرر ہیں","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"عالی قدر (تمہاری باتوں کے) لکھنے والے","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"جو تم کرتے ہو وہ اسے جانتے ہیں","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"اور بدکردار دوزخ میں","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"(یعنی) جزا کے دن اس میں داخل ہوں گے","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"اور اس سے چھپ نہیں سکیں گے","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"When the sky breaks apart","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"And when the stars fall, scattering,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"And when the seas are erupted","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"And when the [contents of] graves are scattered,","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"A soul will [then] know what it has put forth and kept back.","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"O mankind, what has deceived you concerning your Lord, the Generous,","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"Who created you, proportioned you, and balanced you?","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"In whatever form He willed has He assembled you.","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"No! But you deny the Recompense.","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"And indeed, [appointed] over you are keepers,","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"Noble and recording;","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"They know whatever you do.","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"Indeed, the righteous will be in pleasure,","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"And indeed, the wicked will be in Hellfire.","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"They will [enter to] burn therein on the Day of Recompense,","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"And never therefrom will they be absent.","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"And what can make you know what is the Day of Recompense?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"Then, what can make you know what is the Day of Recompense?","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":82,"name":"سُورَةُ الانفِطَارِ","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"जबकि आकाश फट जाएगा","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"और जबकि तारे बिखर जाएँगे","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"और जबकि समुद्र बह पड़ेंगे","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"और जबकि क़बें उखेड़ दी जाएँगी","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"तब हर व्यक्ति जान लेगा जिसे उसने प्राथमिकता दी और पीछे डाला","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"ऐ मनुष्य! किस चीज़ ने तुझे अपने उदार प्रभु के विषय में धोखे में डाल रखा हैं?","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"जिसने तेरा प्रारूप बनाया, फिर नख-शिख से तुझे दुरुस्त किया और तुझे संतुलन प्रदान किया","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"जिस रूप में चाहा उसने तुझे जोड़कर तैयार किया","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"कुछ नहीं, बल्कि तुम बदला दिए जाने का झुठलाते हो","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"जबकि तुमपर निगरानी करनेवाले नियुक्त हैं","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"प्रतिष्ठित लिपिक","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"वे जान रहे होते है जो कुछ भी तुम लोग करते हो","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"निस्संदेह वफ़ादार लोग नेमतों में होंगे","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"और निश्चय ही दुराचारी भड़कती हुई आग में","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"जिसमें वे बदले के दिन प्रवेश करेंगे","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"और उससे वे ओझल नहीं होंगे","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"और तुम्हें क्या मालूम कि बदले का दिन क्या है?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"फिर तुम्हें क्या मालूम कि बदले का दिन क्या है?","numberInSurah":18,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"जिस दिन कोई व्यक्ति किसी व्यक्ति के लिए किसी चीज़ का अधिकारी न होगा, मामला उस दिन अल्लाह ही के हाथ में होगा","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}