{"code":200,"status":"OK","data":[{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"وَشَاهِدٍۢ وَمَشْهُودٍۢ","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌۭ","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"فَعَّالٌۭ لِّمَا يُرِيدُ","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"فِرْعَوْنَ وَثَمُودَ","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"فِى لَوْحٍۢ مَّحْفُوظٍۭ","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"آسمان کی قسم جس میں برج ہیں","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"اور اس دن کی جس کا وعدہ ہے","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"اور حاضر ہونے والے کی اور جو اس کے پاس حاضر کیا جائے اسکی","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"کہ خندقوں (کے کھودنے) والے ہلاک کر دیئے گئے","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"(یعنی) آگ (کی خندقیں) جس میں ایندھن (جھونک رکھا) تھا","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"جب کہ وہ ان (کے کناروں) پر بیٹھے ہوئے تھے","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"اور جو (سختیاں) اہل ایمان پر کر رہے تھے ان کو سامنے دیکھ رہے تھے","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"ان کو مومنوں کی یہی بات بری لگتی تھی کہ وہ خدا پر ایمان لائے ہوئے تھے جو غالب (اور) قابل ستائش ہے","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"وہی جس کی آسمانوں اور زمین میں بادشاہت ہے۔ اور خدا ہر چیز سے واقف ہے","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"جن لوگوں نے مومن مردوں اور مومن عورتوں کو تکلیفیں دیں اور توبہ نہ کی ان کو دوزخ کا (اور) عذاب بھی ہوگا اور جلنے کا عذاب بھی ہوگا","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"(اور) جو لوگ ایمان لائے اور نیک کام کرتے رہے ان کے لیے باغات ہیں جن کے نیچے نہریں بہہ رہی ہیں۔ یہ ہی بڑی کامیابی ہے","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"بےشک تمہارے پروردگار کی پکڑ بڑی سخت ہے","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"وہی پہلی دفعہ پیدا کرتا ہے اور وہی دوبارہ (زندہ) کرے گا","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"اور وہ بخشنے والا اور محبت کرنے والا ہے","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"عرش کا مالک بڑی شان والا","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"جو چاہتا ہے کر دیتا ہے","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"بھلا تم کو لشکروں کا حال معلوم ہوا ہے","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"(یعنی) فرعون اور ثمود کا","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"لیکن کافر (جان بوجھ کر) تکذیب میں (گرفتار) ہیں","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"اور خدا (بھی) ان کو گردا گرد سے گھیرے ہوئے ہے","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"(یہ کتاب ہزل و بطلان نہیں) بلکہ یہ قرآن عظیم الشان ہے","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"لوح محفوظ میں (لکھا ہوا)","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"By the sky containing great stars","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"And [by] the promised Day","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"And [by] the witness and what is witnessed,","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"Cursed were the companions of the trench","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"[Containing] the fire full of fuel,","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"When they were sitting near it","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"And they, to what they were doing against the believers, were witnesses.","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"And they resented them not except because they believed in Allah, the Exalted in Might, the Praiseworthy,","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"To whom belongs the dominion of the heavens and the earth. And Allah, over all things, is Witness.","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"Indeed, those who have tortured the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"Indeed, those who have believed and done righteous deeds will have gardens beneath which rivers flow. That is the great attainment.","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"Indeed, the vengeance of your Lord is severe.","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"Indeed, it is He who originates [creation] and repeats.","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"And He is the Forgiving, the Affectionate,","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"Honorable Owner of the Throne,","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"Effecter of what He intends.","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"Has there reached you the story of the soldiers -","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"[Those of] Pharaoh and Thamud?","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"But they who disbelieve are in [persistent] denial,","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"While Allah encompasses them from behind.","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"But this is an honored Qur'an","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"[Inscribed] in a Preserved Slate.","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Al-Burooj","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"साक्षी है बुर्जोंवाला आकाश,","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"और वह दिन जिसका वादा किया गया है,","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"और देखनेवाला, और जो देखा गया","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"विनष्ट हों खाईवाले,","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"ईधन भरी आगवाले,","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"जबकि वे वहाँ बैठे होंगे","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"और वे जो कुछ ईमानवालों के साथ करते रहे, उसे देखेंगे","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"उन्होंने उन (ईमानवालों) से केवल इस कारण बदला लिया और शत्रुता की कि वे उस अल्लाह पर ईमान रखते थे जो अत्यन्त प्रभुत्वशाली, प्रशंसनीय है,","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"जिसके लिए आकाशों और धरती की बादशाही है। और अल्लाह हर चीज़ का साक्षी है","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"जिन लोगों ने ईमानवाले पुरुषों और ईमानवाली स्त्रियों को सताया और आज़माईश में डाला, फिर तौबा न की, निश्चय ही उनके लिए जहन्नम की यातना है और उनके लिए जलने की यातना है","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"निश्चय ही जो लोग ईमान लाए और उन्होंने अच्छे कर्म किए उनके लिए बाग़ है, जिनके नीचे नहरें बह रही होगी। वही है बड़ी सफलता","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"वास्तव में तुम्हारे रब की पकड़ बड़ी ही सख़्त है","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"वही आरम्भ करता है और वही पुनरावृत्ति करता है,","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"वह बड़ा क्षमाशील, बहुत प्रेम करनेवाला है,","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"सिंहासन का स्वामी है, बडा गौरवशाली,","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"जो चाहे उसे कर डालनेवाला","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"क्या तुम्हें उन सेनाओं की भी ख़बर पहुँची हैं,","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"फ़िरऔन और समूद की?","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"नहीं, बल्कि जिन लोगों ने इनकार किया है, वे झुठलाने में लगे हुए है;","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"हालाँकि अल्लाह उन्हें घेरे हुए है, उनके आगे-पीछे से","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"नहीं, बल्कि वह तो गौरव क़ुरआन है,","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"सुरक्षित पट्टिका में अंकित है","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}