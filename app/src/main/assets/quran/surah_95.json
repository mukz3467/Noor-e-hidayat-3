{"code":200,"status":"OK","data":[{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"وَطُورِ سِينِينَ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"انجیر کی قسم اور زیتون کی","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"اور طور سینین کی","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"اور اس امن والے شہر کی","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"کہ ہم نے انسان کو بہت اچھی صورت میں پیدا کیا ہے","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"پھر (رفتہ رفتہ) اس (کی حالت) کو (بدل کر) پست سے پست کر دیا","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"مگر جو لوگ ایمان لائے اور نیک عمل کرتے رہے انکے لیے بےانتہا اجر ہے","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"تو (اے آدم زاد) پھر تو جزا کے دن کو کیوں جھٹلاتا ہے؟","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"کیا خدا سب سے بڑا حاکم نہیں ہے؟","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"By the fig and the olive","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"And [by] Mount Sinai","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"And [by] this secure city [Makkah],","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"We have certainly created man in the best of stature;","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"Then We return him to the lowest of the low,","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"So what yet causes you to deny the Recompense?","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"Is not Allah the most just of judges?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":95,"name":"سُورَةُ التِّينِ","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"साक्षी है तीन और ज़ैतून","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"और तूर सीनीन,","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"और यह शान्तिपूर्ण भूमि (मक्का)","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"निस्संदेह हमने मनुष्य को सर्वोत्तम संरचना के साथ पैदा किया","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"फिर हमने उसे निकृष्टतम दशा की ओर लौटा दिया, जबकि वह स्वयं गिरनेवाला बना","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"सिवाय उन लोगों के जो ईमान लाए और जिन्होंने अच्छे कर्म किए, तो उनके लिए कभी न समाप्त होनेवाला बदला है","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"अब इसके बाद क्या है, जो बदले के विषय में तुम्हें झुठलाए?","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"क्या अल्लाह सब हाकिमों से बड़ा हाकिम नहीं हैं?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}