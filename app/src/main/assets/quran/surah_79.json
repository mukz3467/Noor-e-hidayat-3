3,"sajda":false},{"number":5715,"text":"اور ان کی جو تیرتے پھرتے ہیں","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"پھر لپک کر آگے بڑھتے ہیں","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"پھر (دنیا کے) کاموں کا انتظام کرتے ہیں","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"(کہ وہ دن آ کر رہے گا) جس دن زمین کو بھونچال آئے گا","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"پھر اس کے پیچھے اور (بھونچال) آئے گا","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"اس دن (لوگوں) کے دل خائف ہو رہے ہوں گے","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"اور آنکھیں جھکی ہوئی","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"(کافر) کہتے ہیں کیا ہم الٹے پاؤں پھر لوٹ جائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"بھلا جب ہم کھوکھلی ہڈیاں ہو جائیں گے (تو پھر زندہ کئے جائیں گے)","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"کہتے ہیں کہ یہ لوٹنا تو (موجب) زیاں ہے","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"وہ تو صرف ایک ڈانٹ ہوگی","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"اس وقت وہ (سب) میدان (حشر) میں آ جمع ہوں گے","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"بھلا تم کو موسیٰ کی حکایت پہنچی ہے","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"جب اُن کے پروردگار نے ان کو پاک میدان (یعنی) طویٰ میں پکارا","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"(اور حکم دیا) کہ فرعون کے پاس جاؤ وہ سرکش ہو رہا ہے","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"اور (اس سے) کہو کہ کیا تو چاہتا ہے کہ پاک ہو جائے؟","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"اور میں تجھے تیرے پروردگار کا رستہ بتاؤں تاکہ تجھ کو خوف (پیدا) ہو","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"غرض انہوں نے اس کو بڑی نشانی دکھائی","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"مگر اس نے جھٹلایا اور نہ مانا","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"پھر لوٹ گیا اور تدبیریں کرنے لگا","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"اور (لوگوں کو) اکٹھا کیا اور پکارا","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"کہنے لگا کہ تمہارا سب سے بڑا مالک میں ہوں","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"تو خدا نے اس کو دنیا اور آخرت (دونوں) کے عذاب میں پکڑ لیا","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"جو شخص (خدا سے) ڈر رکھتا ہے اس کے لیے اس (قصے) میں عبرت ہے","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"بھلا تمہارا بنانا آسان ہے یا آسمان کا؟ اسی نے اس کو بنایا","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"اس کی چھت کو اونچا کیا اور پھر اسے برابر کر دیا","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"اور اسی نے رات کو تاریک بنایا اور (دن کو) دھوپ نکالی","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"اور اس کے بعد زمین کو پھیلا دیا","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"اسی نے اس میں سے اس کا پانی نکالا اور چارا اگایا","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"اور اس پر پہاڑوں کابوجھ رکھ دیا","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"یہ سب کچھ تمہارے اور تمہارے چارپایوں کے فائدے کے لیے (کیا)","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"تو جب بڑی آفت آئے گی","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"اس دن انسان اپنے کاموں کو یاد کرے گا","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"اور دوزخ دیکھنے والے کے سامنے نکال کر رکھ دی جائے گی","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"تو جس نے سرکشی کی","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"اور دنیا کی زندگی کو مقدم سمجھا","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"اس کا ٹھکانہ دوزخ ہے","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"اور جو اپنے پروردگار کے سامنے کھڑے ہونے سے ڈرتا اور جی کو خواہشوں سے روکتا رہا","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"اس کا ٹھکانہ بہشت ہے","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"(اے پیغمبر، لوگ) تم سے قیامت کے بارے میں پوچھتے ہیں کہ اس کا وقوع کب ہو گا؟","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"سو تم اس کے ذکر سے کس فکر میں ہو","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"اس کا منتہا (یعنی واقع ہونے کا وقت) تمہارے پروردگار ہی کو (معلوم ہے)","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"جو شخص اس سے ڈر رکھتا ہے تم تو اسی کو ڈر سنانے والے ہو","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"جب وہ اس کو دیکھیں گے (تو ایسا خیال کریں گے) کہ گویا (دنیا میں صرف) ایک شام یا صبح رہے تھے","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"By those [angels] who extract with violence","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"And [by] those who remove with ease","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"And [by] those who glide [as if] swimming","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"And those who race each other in a race","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"And those who arrange [each] matter,","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"On the Day the blast [of the Horn] will convulse [creation],","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"There will follow it the subsequent [one].","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"Hearts, that Day, will tremble,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"Their eyes humbled.","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"Even if we should be decayed bones?","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"They say, \"That, then, would be a losing return.\"","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"Indeed, it will be but one shout,","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"And suddenly they will be [alert] upon the earth's surface.","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"Has there reached you the story of Moses? -","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"When his Lord called to him in the sacred valley of Tuwa,","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"\"Go to Pharaoh. Indeed, he has transgressed.","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"And say to him, 'Would you [be willing to] purify yourself","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"And let me guide you to your Lord so you would fear [Him]?'\"","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"And he showed him the greatest sign,","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"But Pharaoh denied and disobeyed.","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"Then he turned his back, striving.","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"And he gathered [his people] and called out","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"And said, \"I am your most exalted lord.\"","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"So Allah seized him in exemplary punishment for the last and the first [transgression].","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"Indeed in that is a warning for whoever would fear [Allah].","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"Are you a more difficult creation or is the heaven? Allah constructed it.","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"He raised its ceiling and proportioned it.","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"And He darkened its night and extracted its brightness.","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"And after that He spread the earth.","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"He extracted from it its water and its pasture,","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"And the mountains He set firmly","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"As provision for you and your grazing livestock.","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"But when there comes the greatest Overwhelming Calamity -","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"The Day when man will remember that for which he strove,","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"And Hellfire will be exposed for [all] those who see -","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"So as for he who transgressed","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"And preferred the life of the world,","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"Then indeed, Hellfire will be [his] refuge.","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"Then indeed, Paradise will be [his] refuge.","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"They ask you, [O Muhammad], about the Hour: when is its arrival?","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"In what [position] are you that you should mention it?","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"To your Lord is its finality.","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"You are only a warner for those who fear it.","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":79,"name":"سُورَةُ النَّازِعَاتِ","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"गवाह है वे (हवाएँ) जो ज़ोर से उखाड़ फैंके,","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"और गवाह है वे (हवाएँ) जो नर्मी के साथ चलें,","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"और गवाह है वे जो वायुमंडल में तैरें,","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"फिर एक-दूसरे से अग्रसर हों,","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"और मामले की तदबीर करें","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"जिस दिन हिला डालेगी हिला डालनेवाले घटना,","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"उसके पीछ घटित होगी दूसरी (घटना)","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"कितने ही दिल उस दिन काँप रहे होंगे,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"उनकी निगाहें झुकी होंगी","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"वे कहते है, \"क्या वास्तव में हम पहली हालत में फिर लौटाए जाएँगे?","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"क्या जब हम खोखली गलित हड्डियाँ हो चुके होंगे?\"","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"वे कहते है, \"तब तो लौटना बड़े ही घाटे का होगा।\"","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"वह तो बस एक ही झिड़की होगी,","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"फिर क्या देखेंगे कि वे एक समतल मैदान में उपस्थित है","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"क्या तुम्हें मूसा की ख़बर पहुँची है?","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"जबकि उसके रब ने पवित्र घाटी 'तुवा' में उसे पुकारा था","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"कि \"फ़िरऔन के पास जाओ, उसने बहुत सिर उठा रखा है","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"\"और कहो, क्या तू यह चाहता है कि स्वयं को पाक-साफ़ कर ले,","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"\"और मैं तेरे रब की ओर तेरा मार्गदर्शन करूँ कि तु (उससे) डरे?\"","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"फिर उसने (मूसा ने) उसको बड़ी निशानी दिखाई,","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"किन्तु उसने झुठला दिया और कहा न माना,","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"फिर सक्रियता दिखाते हुए पलटा,","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"फिर (लोगों को) एकत्र किया और पुकारकर कहा,","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"\"मैं तुम्हारा उच्चकोटि का स्वामी हूँ!\"","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"अन्ततः अल्लाह ने उसे आख़िरत और दुनिया की शिक्षाप्रद यातना में पकड़ लिया","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"निस्संदेह इसमें उस व्यक्ति के लिए बड़ी शिक्षा है जो डरे!","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"क्या तुम्हें पैदा करना अधिक कठिन कार्य है या आकाश को? अल्लाह ने उसे बनाया,","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"उसकी ऊँचाई को ख़ूब ऊँचा करके उसे ठीक-ठाक किया;","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"और उसकी रात को अन्धकारमय बनाया और उसका दिवस-प्रकाश प्रकट किया","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"और धरती को देखो! इसके पश्चात उसे फैलाया;","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"उसमें से उसका पानी और उसका चारा निकाला","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"और पहाड़ो को देखो! उन्हें उस (धरती) में जमा दिया,","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"तुम्हारे लिए और तुम्हारे मवेशियों के लिए जीवन-सामग्री के रूप में","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"फिर जब वह महाविपदा आएगी,","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"उस दिन मनुष्य जो कुछ भी उसने प्रयास किया होगा उसे याद करेगा","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"और भड़कती आग (जहन्नम) देखने वालों के लिए खोल दी जाएगी","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"तो जिस किसी ने सरकशी की","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"और सांसारिक जीवन को प्राथमिकता दो होगी,","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"तो निस्संदेह भड़कती आग ही उसका ठिकाना है","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"और रहा वह व्यक्ति जिसने