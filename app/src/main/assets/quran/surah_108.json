{"code":200,"status":"OK","data":[{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"(اے محمدﷺ) ہم نے تم کو کوثر عطا فرمائی ہے","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"تو اپنے پروردگار کے لیے نماز پڑھا کرو اور قربانی دیا کرو","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"کچھ شک نہیں کہ تمہارا دشمن ہی بےاولاد رہے گا","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"Indeed, We have granted you, [O Muhammad], al-Kawthar.","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"So pray to your Lord and sacrifice [to Him alone].","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"Indeed, your enemy is the one cut off.","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":108,"name":"سُورَةُ الكَوۡثَرِ","englishName":"Al-Kawthar","englishNameTranslation":"Abundance","revelationType":"Meccan","numberOfAyahs":3,"ayahs":[{"number":6205,"text":"निश्चय ही हमने तुम्हें कौसर प्रदान किया,","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6206,"text":"अतः तुम अपने रब ही के लिए नमाज़ पढ़ो और (उसी के दिन) क़़ुरबानी करो","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false},{"number":6207,"text":"निस्संदेह तुम्हारा जो वैरी है वही जड़कटा है","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":550,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}