{"code":200,"status":"OK","data":[{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"سَيَذَّكَّرُ مَن يَخْشَىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"(اے پیغمبر) اپنے پروردگار جلیل الشان کے نام کی تسبیح کرو","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"جس نے (انسان کو) بنایا پھر (اس کے اعضاء کو) درست کیا","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"اور جس نے (اس کا) اندازہ ٹہرایا (پھر اس کو) رستہ بتایا","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"اور جس نے چارہ اگایا","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"پھر اس کو سیاہ رنگ کا کوڑا کر دیا","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"ہم تمہیں پڑھا دیں گے کہ تم فراموش نہ کرو گے","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"مگر جو خدا چاہے۔ وہ کھلی بات کو بھی جانتا ہے اور چھپی کو بھی","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"ہم تم کو آسان طریقے کی توفیق دیں گے","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"سو جہاں تک نصیحت (کے) نافع (ہونے کی امید) ہو نصیحت کرتے رہو","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"جو خوف رکھتا ہے وہ تو نصیحت پکڑے گا","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"اور (بےخوف) بدبخت پہلو تہی کرے گا","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"جو (قیامت کو) بڑی (تیز) آگ میں داخل ہو گا","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"پھر وہاں نہ مرے گا اور نہ جئے گا","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"بے شک وہ مراد کو پہنچ گیا جو پاک ہوا","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"اور اپنے پروردگار کے نام کا ذکر کرتا رہا اور نماز پڑھتا رہا","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"مگر تم لوگ تو دنیا کی زندگی کو اختیار کرتے ہو","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"حالانکہ آخرت بہت بہتر اور پائندہ تر ہے","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"یہ بات پہلے صحیفوں میں (مرقوم) ہے","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"(یعنی) ابراہیم اور موسیٰ کے صحیفوں میں","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"Exalt the name of your Lord, the Most High,","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"Who created and proportioned","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"And who destined and [then] guided","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"And who brings out the pasture","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"And [then] makes it black stubble.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"We will make you recite, [O Muhammad], and you will not forget,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"Except what Allah should will. Indeed, He knows what is declared and what is hidden.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"And We will ease you toward ease.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"So remind, if the reminder should benefit;","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"He who fears [Allah] will be reminded.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"But the wretched one will avoid it -","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"[He] who will [enter and] burn in the greatest Fire,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"Neither dying therein nor living.","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"He has certainly succeeded who purifies himself","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"And mentions the name of his Lord and prays.","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"But you prefer the worldly life,","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"While the Hereafter is better and more enduring.","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"Indeed, this is in the former scriptures,","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"The scriptures of Abraham and Moses.","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":87,"name":"سُورَةُ الأَعۡلَىٰ","englishName":"Al-A'laa","englishNameTranslation":"The Most High","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5949,"text":"तसबीह करो, अपने सर्वाच्च रब के नाम की,","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5950,"text":"जिसने पैदा किया, फिर ठीक-ठाक किया,","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5951,"text":"जिसने निर्धारित किया, फिर मार्ग दिखाया,","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5952,"text":"जिसने वनस्पति उगाई,","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5953,"text":"फिर उसे ख़ूब घना और हरा-भरा कर दिया","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5954,"text":"हम तुम्हें पढ़ा देंगे, फिर तुम भूलोगे नहीं","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5955,"text":"बात यह है कि अल्लाह की इच्छा ही क्रियान्वित है। निश्चय ही वह जानता है खुले को भी और उसे भी जो छिपा रहे","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5956,"text":"हम तुम्हें सहज ढंग से उस चीज़ की पात्र बना देंगे जो सहज एवं मृदुल (आरामदायक) है","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5957,"text":"अतः नसीहत करो, यदि नसीहत लाभप्रद हो!","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5958,"text":"नसीहत हासिल कर लेगा जिसको डर होगा,","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5959,"text":"किन्तु उससे कतराएगा वह अत्यन्त दुर्भाग्यवाला,","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5960,"text":"जो बड़ी आग में पड़ेगा,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5961,"text":"फिर वह उसमें न मरेगा न जिएगा","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5962,"text":"सफल हो गया वह जिसने अपने आपको निखार लिया,","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5963,"text":"और अपने रब के नाम का स्मरण किया, अतः नमाज़ अदा की","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5964,"text":"नहीं, बल्कि तुम तो सांसारिक जीवन को प्राथमिकता देते हो,","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5965,"text":"हालाँकि आख़िरत अधिक उत्तम और शेष रहनेवाली है","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5966,"text":"निस्संदेह यही बात पहले की किताबों में भी है;","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false},{"number":5967,"text":"इबराईम और मूसा की किताबों में","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":529,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}