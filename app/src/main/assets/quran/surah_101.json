{"code":200,"status":"OK","data":[{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"مَا ٱلْقَارِعَةُ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"فَأُمُّهُۥ هَاوِيَةٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"نَارٌ حَامِيَةٌۢ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"کھڑ کھڑانے والی","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"کھڑ کھڑانے والی کیا ہے؟","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"تو جس کے (اعمال کے) وزن بھاری نکلیں گے","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"وہ دل پسند عیش میں ہو گا","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"اور جس کے وزن ہلکے نکلیں گے","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"اس کا مرجع ہاویہ ہے","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"دہکتی ہوئی آگ ہے","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"The Striking Calamity -","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"What is the Striking Calamity?","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"And what can make you know what is the Striking Calamity?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"It is the Day when people will be like moths, dispersed,","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"And the mountains will be like wool, fluffed up.","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"Then as for one whose scales are heavy [with good deeds],","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"He will be in a pleasant life.","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"But as for one whose scales are light,","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"His refuge will be an abyss.","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"And what can make you know what that is?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"It is a Fire, intensely hot.","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Al-Qaari'a","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"वह खड़खड़ानेवाली!","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"क्या है वह खड़खड़ानेवाली?","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"और तुम्हें क्या मालूम कि क्या है वह खड़खड़ानेवाली?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"जिस दिन लोग बिखरे हुए पतंगों के सदृश हो जाएँगें,","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"और पहाड़ के धुन के हुए रंग-बिरंग के ऊन जैसे हो जाएँगे","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"फिर जिस किसी के वज़न भारी होंगे,","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"वह मनभाते जीवन में रहेगा","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"और रहा वह व्यक्ति जिसके वज़न हलके होंगे,","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"उसकी माँ होगी गहरा खड्ड","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"और तुम्हें क्या मालूम कि वह क्या है?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"आग है दहकती हुई","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}