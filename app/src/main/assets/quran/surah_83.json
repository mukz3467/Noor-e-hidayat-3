{"code":200,"status":"OK","data":[{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"لِيَوْمٍ عَظِيمٍۢ","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"ناپ اور تول میں کمی کرنے والوں کے لیے خرابی ہے","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"جو لوگوں سے ناپ کر لیں تو پورا لیں","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"اور جب ان کو ناپ کر یا تول کر دیں تو کم کر دیں","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"کیا یہ لوگ نہیں جانتے کہ اٹھائے بھی جائیں گے","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"(یعنی) ایک بڑے (سخت) دن میں","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"جس دن (تمام) لوگ رب العالمین کے سامنے کھڑے ہوں گے","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"سن رکھو کہ بدکارروں کے اعمال سجّین میں ہیں","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"اور تم کیا جانتے ہوں کہ سجّین کیا چیز ہے؟","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"ایک دفتر ہے لکھا ہوا","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"اس دن جھٹلانے والوں کی خرابی ہے","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"(یعنی) جو انصاف کے دن کو جھٹلاتے ہیں","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"اور اس کو جھٹلاتا وہی ہے جو حد سے نکل جانے والا گنہگار ہے","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"جب اس کو ہماری آیتیں سنائی جاتی ہیں تو کہتا ہے کہ یہ تو اگلے لوگوں کے افسانے ہیں","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"دیکھو یہ جو (اعمال بد) کرتے ہیں ان کا ان کے دلوں پر زنگ بیٹھ گیا ہے","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"بےشک یہ لوگ اس روز اپنے پروردگار (کے دیدار) سے اوٹ میں ہوں گے","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"پھر دوزخ میں جا داخل ہوں گے","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"پھر ان سے کہا جائے گا کہ یہ وہی چیز ہے جس کو تم جھٹلاتے تھے","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"(یہ بھی) سن رکھو کہ نیکوکاروں کے اعمال علیین میں ہیں","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"اور تم کو کیا معلوم کہ علیین کیا چیز ہے؟","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"ایک دفتر ہے لکھا ہوا","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"جس کے پاس مقرب (فرشتے) حاضر رہتے ہیں","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"بےشک نیک لوگ چین میں ہوں گے","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"تختوں پر بیٹھے ہوئے نظارے کریں گے","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"تم ان کے چہروں ہی سے راحت کی تازگی معلوم کر لو گے","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"ان کو خالص شراب سربمہر پلائی جائے گی","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"جس کی مہر مشک کی ہو گی تو (نعمتوں کے) شائقین کو چاہیے کہ اسی سے رغبت کریں","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"اور اس میں تسنیم (کے پانی) کی آمیزش ہو گی","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"وہ ایک چشمہ ہے جس میں سے (خدا کے) مقرب پیئیں گے","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"جو گنہگار (یعنی کفار) ہیں وہ (دنیا میں) مومنوں سے ہنسی کیا کرتے تھے","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"اور جب ان کے پاس سے گزرتے تو حقارت سے اشارے کرتے","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"اور جب اپنے گھر کو لوٹتے تو اتراتے ہوئے لوٹتے","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"اور جب ان (مومنوں) کو دیکھتے تو کہتے کہ یہ تو گمراہ ہیں","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"حالانکہ وہ ان پر نگراں بنا کر نہیں بھیجے گئے تھے","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"تو آج مومن کافروں سے ہنسی کریں گے","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"(اور) تختوں پر (بیٹھے ہوئے ان کا حال) دیکھ رہے ہوں گے","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"تو کافروں کو ان کے عملوں کا (پورا پورا) بدلہ مل گیا","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"Woe to those who give less [than due],","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"Who, when they take a measure from people, take in full.","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"But if they give by measure or by weight to them, they cause loss.","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"Do they not think that they will be resurrected","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"For a tremendous Day -","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"The Day when mankind will stand before the Lord of the worlds?","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"No! Indeed, the record of the wicked is in sijjeen.","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"And what can make you know what is sijjeen?","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"It is [their destination recorded in] a register inscribed.","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"Woe, that Day, to the deniers,","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"Who deny the Day of Recompense.","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"And none deny it except every sinful transgressor.","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"When Our verses are recited to him, he says, \"Legends of the former peoples.\"","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"No! Rather, the stain has covered their hearts of that which they were earning.","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"No! Indeed, from their Lord, that Day, they will be partitioned.","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"Then indeed, they will [enter and] burn in Hellfire.","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"Then it will be said [to them], \"This is what you used to deny.\"","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"No! Indeed, the record of the righteous is in 'illiyyun.","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"And what can make you know what is 'illiyyun?","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"It is [their destination recorded in] a register inscribed","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"Which is witnessed by those brought near [to Allah].","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"Indeed, the righteous will be in pleasure","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"On adorned couches, observing.","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"You will recognize in their faces the radiance of pleasure.","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"They will be given to drink [pure] wine [which was] sealed.","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"The last of it is musk. So for this let the competitors compete.","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"And its mixture is of Tasneem,","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"A spring from which those near [to Allah] drink.","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"Indeed, those who committed crimes used to laugh at those who believed.","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"And when they passed by them, they would exchange derisive glances.","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"And when they returned to their people, they would return jesting.","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"And when they saw them, they would say, \"Indeed, those are truly lost.\"","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"But they had not been sent as guardians over them.","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"So Today those who believed are laughing at the disbelievers,","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"On adorned couches, observing.","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"Have the disbelievers [not] been rewarded [this Day] for what they used to do?","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","englishName":"Al-Mutaffifin","englishNameTranslation":"Defrauding","revelationType":"Meccan","numberOfAyahs":36,"ayahs":[{"number":5849,"text":"तबाही है घटानेवालों के लिए,","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5850,"text":"जो नापकर लोगों पर नज़र जमाए हुए लेते हैं तो पूरा-पूरा लेते हैं,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5851,"text":"किन्तु जब उन्हें नापकर या तौलकर देते हैं तो घटाकर देते हैं","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5852,"text":"क्या वे समझते नहीं कि उन्हें (जीवित होकर) उठना है,","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5853,"text":"एक भारी दिन के लिए,","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5854,"text":"जिस दिन लोग सारे संसार के रब के सामने खड़े होंगे?","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5855,"text":"कुछ नहीं, निश्चय ही दुराचारियों का काग़ज 'सिज्जीन' में है","numberInSurah":7,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5856,"text":"तुम्हें क्या मालूम कि 'सिज्जीन' क्या हैं?","numberInSurah":8,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5857,"text":"मुहर लगा हुआ काग़ज","numberInSurah":9,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5858,"text":"तबाही है उस दिन झुठलाने-वालों की,","numberInSurah":10,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5859,"text":"जो बदले के दिन को झुठलाते है","numberInSurah":11,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5860,"text":"और उसे तो बस प्रत्येक वह क्यक्ति ही झूठलाता है जो सीमा का उल्लंघन करनेवाला, पापी है","numberInSurah":12,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5861,"text":"जब हमारी आयतें उसे सुनाई जाती है तो कहता है, \"ये तो पहले की कहानियाँ है।\"","numberInSurah":13,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5862,"text":"कुछ नहीं, बल्कि जो कुछ वे कमाते रहे है वह उनके दिलों पर चढ़ गया है","numberInSurah":14,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5863,"text":"कुछ नहीं, अवश्य ही वे उस दिन अपने रब से ओट में होंगे,","numberInSurah":15,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5864,"text":"फिर वे भड़कती आग में जा पड़ेगे","numberInSurah":16,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5865,"text":"फिर कहा जाएगा, \"यह वही है जिस तुम झुठलाते थे\"","numberInSurah":17,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5866,"text":"कुछ नही, निस्संदेह वफ़ादार लोगों का काग़ज़ 'इल्लीयीन' (उच्च श्रेणी के लोगों) में है।-","numberInSurah":18,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5867,"text":"और तुम क्या जानो कि 'इल्लीयीन' क्या है? -","numberInSurah":19,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5868,"text":"लिखा हुआ रजिस्टर","numberInSurah":20,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5869,"text":"जिसे देखने के लिए सामीप्य प्राप्त लोग उपस्थित होंगे,","numberInSurah":21,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5870,"text":"निस्संदेह अच्छे लोग नेमतों में होंगे,","numberInSurah":22,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5871,"text":"ऊँची मसनदों पर से देख रहे होंगे","numberInSurah":23,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5872,"text":"उनके चहरों से तुम्हें नेमतों की ताज़गी और आभा को बोध हो रहा होगा,","numberInSurah":24,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5873,"text":"उन्हें मुहरबंद विशुद्ध पेय पिलाया जाएगा,","numberInSurah":25,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5874,"text":"मुहर उसकी मुश्क ही होगी - जो लोग दूसरी पर बाज़ी ले जाना चाहते हो वे इस चीज़ को प्राप्त करने में बाज़ी ले जाने का प्रयास करे -","numberInSurah":26,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5875,"text":"और उसमें 'तसनीम' का मिश्रण होगा,","numberInSurah":27,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5876,"text":"हाल यह है कि वह एक स्रोत है, जिसपर बैठकर सामीप्य प्राप्त लोग पिएँगे","numberInSurah":28,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5877,"text":"जो अपराधी है वे ईमान लानेवालों पर हँसते थे,","numberInSurah":29,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5878,"text":"और जब उनके पास से गुज़रते तो आपस में आँखों और भौंहों से इशारे करते थे,","numberInSurah":30,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5879,"text":"और जब अपने लोगों की ओर पलटते है तो चहकते, इतराते हुए पलटते थे,","numberInSurah":31,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5880,"text":"और जब उन्हें देखते तो कहते, \"ये तो भटके हुए है।\"","numberInSurah":32,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5881,"text":"हालाँकि वे उनपर कोई निगरानी करनेवाले बनाकर नहीं भेजे गए थे","numberInSurah":33,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5882,"text":"तो आज ईमान लानेवाले, इनकार करनेवालों पर हँस रहे हैं,","numberInSurah":34,"juz":30,"manzil":7,"page":588,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5883,"text":"ऊँची मसनदों पर से देख रहे है","numberInSurah":35,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false},{"number":5884,"text":"क्या मिल गया बदला इनकार करनेवालों को उसका जो कुछ वे करते रहे है?","numberInSurah":36,"juz":30,"manzil":7,"page":589,"ruku":525,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}