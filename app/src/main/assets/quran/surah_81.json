{"code":200,"status":"OK","data":[{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"فَأَيْنَ تَذْهَبُونَ","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"جب سورج لپیٹ لیا جائے گا","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"جب تارے بےنور ہو جائیں گے","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"اور جب پہاڑ چلائے جائیں گے","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"اور جب وحشی جانور جمع اکٹھے ہو جائیں گے","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"اور جب دریا آگ ہو جائیں گے","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"اور جب روحیں (بدنوں سے) ملا دی جائیں گی","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"کہ وہ کس گناہ پرماری گئی","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"اور جب (عملوں کے) دفتر کھولے جائیں گے","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"اور جب آسمانوں کی کھال کھینچ لی جائے گی","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"اور جب دوزخ (کی آگ) بھڑکائی جائے گی","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"اور بہشت جب قریب لائی جائے گی","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"(اور) جو سیر کرتے اور غائب ہو جاتے ہیں","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"اور رات کی قسم جب ختم ہونے لگتی ہے","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"اور صبح کی قسم جب نمودار ہوتی ہے","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"سردار (اور) امانت دار ہے","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"اور یہ شیطان مردود کا کلام نہیں","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"پھر تم کدھر جا رہے ہو","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"یہ تو جہان کے لوگوں کے لیے نصیحت ہے","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"When the sun is wrapped up [in darkness]","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"And when the stars fall, dispersing,","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"And when the mountains are removed","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"And when full-term she-camels are neglected","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"And when the wild beasts are gathered","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"And when the seas are filled with flame","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"And when the souls are paired","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"And when the girl [who was] buried alive is asked","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"For what sin she was killed","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"And when the pages are made public","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"And when the sky is stripped away","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"And when Hellfire is set ablaze","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"And when Paradise is brought near,","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"A soul will [then] know what it has brought [with it].","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"So I swear by the retreating stars -","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"Those that run [their courses] and disappear -","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"And by the night as it closes in","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"And by the dawn when it breathes","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"[Who is] possessed of power and with the Owner of the Throne, secure [in position],","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"Obeyed there [in the heavens] and trustworthy.","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"And your companion is not [at all] mad.","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"And he has already seen Gabriel in the clear horizon.","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"And Muhammad is not a withholder of [knowledge of] the unseen.","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"And the Qur'an is not the word of a devil, expelled [from the heavens].","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"So where are you going?","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"It is not except a reminder to the worlds","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"For whoever wills among you to take a right course.","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"And you do not will except that Allah wills - Lord of the worlds.","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":81,"name":"سُورَةُ التَّكۡوِيرِ","englishName":"At-Takwir","englishNameTranslation":"The Overthrowing","revelationType":"Meccan","numberOfAyahs":29,"ayahs":[{"number":5801,"text":"जब सूर्य लपेट दिया जाएगा,","numberInSurah":1,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5802,"text":"सारे तारे मैले हो जाएँगे,","numberInSurah":2,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5803,"text":"जब पहाड़ चलाए जाएँगे,","numberInSurah":3,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5804,"text":"जब दस मास की गाभिन ऊँटनियाँ आज़ाद छोड़ दी जाएँगी,","numberInSurah":4,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5805,"text":"जब जंगली जानवर एकत्र किए जाएँगे,","numberInSurah":5,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5806,"text":"जब समुद्र भड़का दिया जाएँगे,","numberInSurah":6,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5807,"text":"जब लोग क़िस्म-क़िस्म कर दिए जाएँगे,","numberInSurah":7,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5808,"text":"और जब जीवित गाड़ी गई लड़की से पूछा जाएगा,","numberInSurah":8,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5809,"text":"कि उसकी हत्या किस गुनाह के कारण की गई,","numberInSurah":9,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5810,"text":"और जब कर्म-पत्र फैला दिए जाएँगे,","numberInSurah":10,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5811,"text":"और जब आकाश की खाल उतार दी जाएगी,","numberInSurah":11,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5812,"text":"जब जहन्नम को दहकाया जाएगा,","numberInSurah":12,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5813,"text":"और जब जन्नत निकट कर दी जाएगी,","numberInSurah":13,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5814,"text":"तो कोई भी क्यक्ति जान लेगा कि उसने क्या उपस्थित किया है","numberInSurah":14,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5815,"text":"अतः नहीं! मैं क़सम खाता हूँ पीछे हटनेवालों की,","numberInSurah":15,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5816,"text":"चलनेवालों, छिपने-दुबकने-वालों की","numberInSurah":16,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5817,"text":"साक्षी है रात्रि जब वह प्रस्थान करे,","numberInSurah":17,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5818,"text":"और साक्षी है प्रातः जब वह साँस ले","numberInSurah":18,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5819,"text":"निश्चय ही वह एक आदरणीय संदेशवाहक की लाई हुई वाणी है,","numberInSurah":19,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5820,"text":"जो शक्तिवाला है, सिंहासनवाले के यहाँ जिसकी पैठ है","numberInSurah":20,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5821,"text":"उसका आदेश माना जाता है, वहाँ वह विश्वासपात्र है","numberInSurah":21,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5822,"text":"तुम्हारा साथी कोई दीवाना नहीं,","numberInSurah":22,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5823,"text":"उसने तो (पराकाष्ठान के) प्रत्यक्ष क्षितिज पर होकर उस (फ़रिश्ते) को देखा है","numberInSurah":23,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5824,"text":"और वह परोक्ष के मामले में कृपण नहीं है,","numberInSurah":24,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5825,"text":"और वह (क़ुरआन) किसी धुतकारे हुए शैतान की लाई हुई वाणी नहीं है","numberInSurah":25,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5826,"text":"फिर तुम किधर जा रहे हो?","numberInSurah":26,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5827,"text":"वह तो सारे संसार के लिए बस एक अनुस्मृति है,","numberInSurah":27,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5828,"text":"उसके लिए तो तुममे से सीधे मार्ग पर चलना चाहे","numberInSurah":28,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false},{"number":5829,"text":"और तुम नहीं चाह सकते सिवाय इसके कि सारे जहान का रब अल्लाह चाहे","numberInSurah":29,"juz":30,"manzil":7,"page":586,"ruku":523,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}