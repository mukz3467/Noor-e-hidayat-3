{"code":200,"status":"OK","data":[{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"جب زمین بھونچال سے ہلا دی جائے گی","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"اور زمین اپنے (اندر) کے بوجھ نکال ڈالے گی","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"اور انسان کہے گا کہ اس کو کیا ہوا ہے؟","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"اس روز وہ اپنے حالات بیان کردے گی","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"کیونکہ تمہارے پروردگار نے اس کو حکم بھیجا (ہوگا)","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"اس دن لوگ گروہ گروہ ہو کر آئیں گے تاکہ ان کو ان کے اعمال دکھا دیئے جائیں","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"تو جس نے ذرہ بھر نیکی کی ہو گی وہ اس کو دیکھ لے گا","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"اور جس نے ذرہ بھر برائی کی ہوگی وہ اسے دیکھ لے گا","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"When the earth is shaken with its [final] earthquake","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"And the earth discharges its burdens","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"And man says, \"What is [wrong] with it?\" -","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"That Day, it will report its news","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"Because your Lord has commanded it.","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"So whoever does an atom's weight of good will see it,","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"And whoever does an atom's weight of evil will see it.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"जब धरती इस प्रकार हिला डाली जाएगी जैसा उसे हिलाया जाना है,","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"और धरती अपने बोझ बाहर निकाल देगी,","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"और मनुष्य कहेगा, \"उसे क्या हो गया है?\"","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"उस दिन वह अपना वृत्तांत सुनाएगी,","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"इस कारण कि तुम्हारे रब ने उसे यही संकेत किया होगा","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"उस दिन लोग अलग-अलग निकलेंगे, ताकि उन्हें कर्म दिखाए जाएँ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"अतः जो कोई कणभर भी नेकी करेगा, वह उसे देख लेगा,","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"और जो कोई कणभर भी बुराई करेगा, वह भी उसे देख लेगा","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}