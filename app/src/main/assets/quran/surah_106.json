{"code":200,"status":"OK","data":[{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لِإِيلَٰفِ قُرَيْشٍ","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"قریش کے مانوس کرنے کے سبب","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"(یعنی) ان کو جاڑے اور گرمی کے سفر سے مانوس کرنے کے سبب","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"لوگوں کو چاہیئے کہ (اس نعمت کے شکر میں) اس گھر کے مالک کی عبادت کریں","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"جس نے ان کو بھوک میں کھانا کھلایا اور خوف سے امن بخشا","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ur.jalandhry","language":"ur","name":"جالندہری","englishName":"Fateh Muhammad Jalandhry","format":"text","type":"translation","direction":"rtl"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"For the accustomed security of the Quraysh -","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"Their accustomed security [in] the caravan of winter and summer -","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"Let them worship the Lord of this House,","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":106,"name":"سُورَةُ قُرَيۡشٍ","englishName":"Quraish","englishNameTranslation":"Quraysh","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6194,"text":"कितना है क़ुरैश को लगाए और परचाए रखना,","numberInSurah":1,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6195,"text":"लगाए और परचाए रखना उन्हें जाड़े और गर्मी की यात्रा से","numberInSurah":2,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6196,"text":"अतः उन्हें चाहिए कि इस घर (काबा) के रब की बन्दगी करे,","numberInSurah":3,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false},{"number":6197,"text":"जिसने उन्हें खिलाकर भूख से बचाया और निश्चिन्तता प्रदान करके भय से बचाया","numberInSurah":4,"juz":30,"manzil":7,"page":602,"ruku":548,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"hi.farooq","language":"hi","name":"फ़ारूक़ ख़ान & अहमद","englishName":"Muhammad Farooq Khan and Muhammad Ahmed","format":"text","type":"translation","direction":"ltr"}}]}